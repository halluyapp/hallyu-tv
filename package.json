{
  "name": "hallyu-tv",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:mobile": "APP_VARIANT=mobile EXPO_PUBLIC_APP_VARIANT=mobile expo start --dev-client",
    "start:tv": "APP_VARIANT=tv EXPO_PUBLIC_APP_VARIANT=tv expo start --dev-client",
    "android": "APP_VARIANT=mobile EXPO_PUBLIC_APP_VARIANT=mobile expo run:android",
    "android:tv": "APP_VARIANT=tv EXPO_PUBLIC_APP_VARIANT=tv expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "verify:provider": "bun scripts/verify-provider.mjs",
    "test": "bun test",
    "build:mobile": "export APP_VARIANT=mobile EXPO_PUBLIC_APP_VARIANT=mobile && expo prebuild -p android --clean && cd android && ./gradlew assembleRelease --no-daemon",
    "build:tv": "export APP_VARIANT=tv EXPO_PUBLIC_APP_VARIANT=tv && expo prebuild -p android --clean && cd android && ./gradlew assembleRelease --no-daemon",
    "build:android:all": "bun run build:mobile && cp android/app/build/outputs/apk/release/app-release.apk /tmp/hallyu-mobile.apk && bun run build:tv && cp android/app/build/outputs/apk/release/app-release.apk /tmp/hallyu-tv.apk"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.7",
    "expo-linear-gradient": "~15.0.8",
    "expo-screen-orientation": "~9.0.9",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "lucide-react-native": "^0.545.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
